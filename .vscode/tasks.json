{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prune gone branches",
            "type": "shell",
            "command": "git fetch --prune && git branch -vv | grep ': gone]' | awk '{print ($1)}' | xargs -r git branch -d",
            "options": {
                "shell": {
                    "executable": "/usr/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}